{
  "name": "@byside/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "db:setup": "prisma generate && prisma db push",
    "test": "npm run build && tsx --test ../tests/*.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-express": "^11.2.10",
    "@nestjs/swagger": "^11.4.8",
    "@prisma/client": "6.5.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "dotenv": "16.4.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "5.0.0",
    "@types/node": "22.13.0",
    "@types/ws": "^8.18.1",
    "prisma": "6.5.0",
    "tsx": "4.19.3"
  }
}
