# OpenAI compatible Chat Completions endpoint and model
YATUAN_AI_ENDPOINT=https://api.deepseek.com/chat/completions
YATUAN_AI_MODEL=deepseek-flash
YATUAN_AI_KEY=
# auto：DeepSeek 默认关闭思考以降低延迟，其他模型不传此参数；也可设 enabled 或 disabled（需供应商支持）
YATUAN_AI_THINKING=auto
# 可选演示：biscuit-sausage 将已识别的饼干/糕点和香肠关联用户提供的测试包装资料（并标记非品牌识别）；留空关闭
YATUAN_FOOD_DEMO=
# 豆包语音新版控制台的 API Key（仅保存在服务端）
VOLC_SPEECH_API_KEY=
# 端到端实时语音可单独配置；留空时复用 VOLC_SPEECH_API_KEY 或环境变量 VOLC_API_KEY
VOLC_REALTIME_API_KEY=
VOLC_REALTIME_VOICE=zh_female_vv_jupiter_bigtts
# 根据控制台开通的识别资源调整：小时版 duration / 并发版 concurrent
VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_SPEAKER=zh_female_vv_uranus_bigtts
# 兼容旧配置，仅用于 TTS；新接入建议使用 VOLC_SPEECH_API_KEY
YATUAN_TTS_KEY=
